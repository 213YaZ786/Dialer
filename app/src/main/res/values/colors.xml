<resources>
    <!--
        The launcher icon follows the wallpaper: the disc takes a bright tone
        of the accent, 500, which its grey body shades and its white rim
        lights; the ground is the palest tone of the accent by day and a deep
        neutral by night, as for the other apps. The handset stays white.
    -->
    <color name="ic_launcher_background">@android:color/system_accent1_50</color>
    <color name="ic_launcher_disc">@android:color/system_accent1_500</color>
</resources>
