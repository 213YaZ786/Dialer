<resources>
    <!--
        The launcher icon follows the wallpaper: the disc takes a bright tone
        of the accent, 500, which its grey body shades and its white rim
        lights. The ground is the disc's own tone (its rim grey is white), so
        no pale ring shows around it, whatever the mask, as Launcher's.
        The handset stays white.
    -->
    <color name="ic_launcher_background">@android:color/system_accent1_500</color>
    <color name="ic_launcher_disc">@android:color/system_accent1_500</color>
</resources>
