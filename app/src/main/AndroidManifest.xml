<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- One request to GitHub when the app opens, for the newest release. Nothing else goes out. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only used when the user chooses to install updates from the app; Android asks them then. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The incoming call and the call in progress are notifications; so is the note after an update. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- An incoming call fills the screen, even locked. Android 14 keeps it for calling and alarm apps. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The call keeps running with no screen open: a foreground service of the phone call type,
         which Android only grants to the phone app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- Places the calls dialled in the app; Android grants it with the phone app role. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Finds contacts as a number is typed. Read only, nothing leaves the phone. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Turns the screen off against the ear during a call. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".DialerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dialer"
        android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Dialer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The dial intents. Android requires both of a phone app: the phone
                 button with no number, and a number to dial from a link or an app. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- The call screen, in a task of its own so it never brings the rest of
             the app along, and out of the recent apps: the call notification
             brings it back. -->
        <activity
            android:name=".feature.call.CallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.dialer.app.call"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Dialer" />

        <!-- Bound by Telecom while there are calls, because Dialer is the phone app.
             Telecom rings and vibrates itself (RINGING false), so the contact's
             ringtone, Do Not Disturb and the ringer switch work as the system sets them. -->
        <service
            android:name=".core.call.DialerInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:foregroundServiceType="phoneCall">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="false" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Decline and Hang up in the call notifications. -->
        <receiver
            android:name=".core.call.CallActionReceiver"
            android:exported="false" />

        <!-- After an update the app installed itself: a notification to open it again. -->
        <receiver
            android:name=".core.update.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
