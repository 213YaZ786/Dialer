<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- One request to GitHub when the app opens, for the newest release. Nothing else goes out. -->
    <!-- The camera of an encrypted video call: Android lets only the phone app
         showing the call pick it; asked at the first video call. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The call island over the other apps, when the user allows it in Android's settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- What the Contacts app may ask about the calls (keep in touch), and the private names it keeps: apps signed with the same key only. -->
    <permission
        android:name="${applicationId}.permission.PEOPLE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.yaz.contacts.permission.PRIVATE" />
    <uses-permission android:name="com.yaz.contacts.debug.permission.PRIVATE" />

    <queries>
        <!-- The Contacts app's private names (signature level). -->
        <provider android:authorities="com.yaz.contacts.private" />
        <provider android:authorities="com.yaz.contacts.debug.private" />
    </queries>
    <!-- Only used when the user chooses to install updates from the app; Android asks them then. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The incoming call and the call in progress are notifications; so is the note after an update. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- An incoming call fills the screen, even locked. Android 14 keeps it for calling and alarm apps. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The call keeps running with no screen open: a foreground service of the phone call type,
         which Android only grants to the phone app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- Places the calls dialled in the app; Android grants it with the phone app role. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Finds contacts as a number is typed. Read only, nothing leaves the phone. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Marks a contact as a favourite (the star), nothing else is written. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Recents: reads the call history, marks missed calls as seen and
         deletes the calls the user removes. Granted with the phone app role. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <!-- Lets Telecom hand the missed call notification to Dialer, which then
         offers Call back and Message. Granted with the phone app role. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- One buzz when the person called picks up, felt at the ear or in a pocket. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Hides other apps' floating windows over the call screen, so nothing can
         lay a false button over Answer or Hang up. Granted at install. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Knows when Android's Advanced Protection is on, to be stricter then. -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />
    <!-- Turns the screen off against the ear during a call. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".DialerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dialer"
        android:enableOnBackInvokedCallback="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Dialer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The dial intents. Android requires both of a phone app: the phone
                 button with no number, and a number to dial from a link or an app. -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
            <!-- The calls with a number, from the contacts or messaging app: shows
                 the page, never acts. -->
            <intent-filter>
                <action android:name="com.dialer.app.action.SHOW_NUMBER" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <!-- "Call history": the system's missed call notification and other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/calls" />
            </intent-filter>
        </activity>

        <!-- The call screen, in a task of its own so it never brings the rest of
             the app along, and out of the recent apps: the call notification
             brings it back. -->
        <activity
            android:name=".feature.call.CallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.yaz.dialer.call"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Dialer" />

        <!-- Bound by Telecom while there are calls, because Dialer is the phone app.
             Telecom rings and vibrates itself (RINGING false), so the contact's
             ringtone, Do Not Disturb and the ringer switch work as the system sets them. -->
        <service
            android:name=".core.call.DialerInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:foregroundServiceType="phoneCall">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="false" />
            <!-- The encrypted calls of the messaging app (a self-managed line)
                 show on this same call screen. -->
            <meta-data
                android:name="android.telecom.INCLUDE_SELF_MANAGED_CALLS"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Missed calls: Telecom gives the notification to the phone app. Only
             the system may send it (it holds every permission): another app
             cannot fake a missed call whose Call back dials its number. -->
        <receiver
            android:name=".core.call.MissedCallReceiver"
            android:exported="true"
            android:permission="android.permission.MODIFY_PHONE_STATE">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- Looks at incoming calls before they ring: hidden numbers and
             unknown callers, as the user chose. Bound by Telecom only. -->
        <service
            android:name=".core.call.Screening"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Decline and Hang up in the call notifications, Call back on a missed call. -->
        <receiver
            android:name=".core.call.CallActionReceiver"
            android:exported="false" />

        <!-- After an update the app installed itself: a notification to open it again. -->
        <receiver
            android:name=".core.update.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- The Contacts app asks when the last calls with some numbers were, and which unsaved numbers come back often. -->
        <provider
            android:name=".core.calllog.CallsDoor"
            android:authorities="${applicationId}.people"
            android:exported="true"
            android:permission="${applicationId}.permission.PEOPLE" />
    </application>
</manifest>
